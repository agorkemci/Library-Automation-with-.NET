@model IEnumerable<Library_Automation.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Books Management</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Book</a> 
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th style="width: 70px;"></th>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Category</th>
            <th>Floor</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {

            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.CoverFileName))
                    {
                        <img src="~/uploads/covers/@item.CoverFileName" alt="@item.Title" class="rounded" style="height: 56px;" />
                    }
                    else
                    {
                        <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted"
                             style="width: 40px; height: 56px;">
                            <i class="bi bi-book"></i>
                        </div>
                    }
                </td>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.ISBN</td>
                <td>@item.Category?.Name</td>
                <td>Floor: @item.Floor/@item.Shelf</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>