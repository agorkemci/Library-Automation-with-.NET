@model IEnumerable<Library_Automation.ViewModels.CategoryListItemViewModel>
@{
    ViewData["Title"] = "Categories";
}




<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories</h2>
    <a asp-action="Create" class="btn btn-primary">
        New Category
    </a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>
                Name
            </th>

            <th>
                Books
            </th>

            <th>
                
            </th>
        </tr>
        
    </thead>
    <tbody>
        @foreach(var category in Model)
        {
            <tr>
                <td>
                    @category.Name
                </td>
                <td>
                    @category.BookCount
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>

</table>